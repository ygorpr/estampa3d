[{"text": "Sobrou vinho? Calma, não joga fora.", "words": [["Sobrou", 0.0, 0.43], ["vinho?", 0.488, 0.906], ["Calma,", 1.057, 1.579], ["não", 1.695, 1.811], ["joga", 1.858, 2.09], ["fora.", 2.148, 2.74]], "dur": 2.76898}, {"text": "A festa acabou e ficou meia garrafa. E agora?", "words": [["A", 0.0, 0.104], ["festa", 0.221, 0.534], ["acabou", 0.557, 0.952], ["e", 0.998, 1.022], ["ficou", 1.057, 1.37], ["meia", 1.498, 1.73], ["garrafa.", 1.776, 2.392], ["E", 2.508, 2.624], ["agora?", 2.694, 3.297]], "dur": 3.343673}, {"text": "Primeiro: tampe com a rolha. O oxigênio é o inimigo.", "words": [["Primeiro:", 0.0, 0.499], ["tampe", 0.685, 0.998], ["com", 1.033, 1.173], ["a", 1.231, 1.254], ["rolha.", 1.289, 1.683], ["O", 1.823, 1.858], ["oxigênio", 1.916, 2.531], ["é", 2.612, 2.67], ["o", 2.728, 2.763], ["inimigo.", 2.81, 3.529]], "dur": 3.578776}, {"text": "Segundo: geladeira. Até o tinto!", "words": [["Segundo:", 0.0, 0.627], ["geladeira.", 0.731, 1.405], ["Até", 1.544, 1.834], ["o", 1.892, 1.927], ["tinto!", 1.985, 2.647]], "dur": 2.690612}, {"text": "O frio segura a oxidação e protege o sabor.", "words": [["O", 0.0, 0.093], ["frio", 0.209, 0.395], ["segura", 0.441, 0.778], ["a", 0.801, 0.836], ["oxidação", 0.929, 1.66], ["e", 1.695, 1.718], ["protege", 1.765, 2.31], ["o", 2.334, 2.357], ["sabor.", 2.403, 3.111]], "dur": 3.160816}, {"text": "Fechado e gelado, o tinto dura de três a cinco dias.", "words": [["Fechado", 0.0, 0.511], ["e", 0.534, 0.557], ["gelado,", 0.604, 1.103], ["o", 1.242, 1.324], ["tinto", 1.382, 1.695], ["dura", 1.753, 1.974], ["de", 2.02, 2.113], ["três", 2.252, 2.635], ["a", 2.717, 2.763], ["cinco", 2.821, 3.216], ["dias.", 3.274, 4.04]], "dur": 4.075102}, {"text": "No terceiro dia... continua ótimo.", "words": [["No", 0.0, 0.116], ["terceiro", 0.174, 0.592], ["dia...", 0.65, 1.08], ["continua", 1.196, 1.672], ["ótimo.", 1.788, 2.461]], "dur": 2.507755}, {"text": "Mas se você esquecer lá...", "words": [["Mas", 0.0, 0.255], ["se", 0.302, 0.43], ["você", 0.488, 0.72], ["esquecer", 0.789, 1.196], ["lá...", 1.265, 1.811]], "dur": 1.854694}, {"text": "no sétimo dia... virou vinagre.", "words": [["no", 0.0, 0.151], ["sétimo", 0.209, 0.569], ["dia...", 0.615, 0.987], ["virou", 1.161, 1.393], ["vinagre.", 1.44, 2.09]], "dur": 2.115918}, {"text": "Espumante, até três dias. Branco e rosé, até sete. Tinto, até cinco.", "words": [["Espumante,", 0.0, 0.72], ["até", 0.766, 0.987], ["três", 1.045, 1.289], ["dias.", 1.347, 1.811], ["Branco", 1.95, 2.299], ["e", 2.322, 2.345], ["rosé,", 2.392, 2.844], ["até", 2.891, 3.123], ["sete.", 3.204, 3.692], ["Tinto,", 3.831, 4.238], ["até", 4.284, 4.516], ["cinco.", 4.586, 5.294]], "dur": 5.32898}, {"text": "Wine Know. Dark Divino.", "words": [["Wine", 0.0, 0.36], ["Know.", 0.383, 0.72], ["Dark", 0.906, 1.184], ["Divino.", 1.289, 1.95]], "dur": 1.985306}]