[{"text": "Sabe aquelas gotinhas que escorrem na taça depois que você gira o vinho? Muita gente olha e diz: \"esse vinho é bom!\" Será?", "words": [["Sabe", 0.0, 0.26], ["aquelas", 0.26, 0.56], ["gotinhas", 0.56, 0.96], ["que", 0.96, 1.16], ["escorrem", 1.16, 1.64], ["na", 1.64, 1.74], ["taça", 1.74, 2.12], ["depois", 2.12, 2.38], ["que", 2.38, 2.58], ["você", 2.58, 2.8], ["gira", 2.8, 3.16], ["o", 3.16, 3.22], ["vinho?", 3.22, 3.52], ["Muita", 4.02, 4.32], ["gente", 4.32, 4.46], ["olha", 4.46, 4.88], ["e", 4.88, 5.1], ["diz:", 5.1, 5.3], ["\"esse", 5.3, 5.84], ["vinho", 5.84, 6.14], ["é", 6.14, 6.24], ["bom!\"", 6.24, 6.46], ["Será?", 6.82, 7.38]], "dur": 7.915102}, {"text": "Vou te contar: essas gotas não mostram qualidade nenhuma. É física pura! E a história delas passa até pela Bíblia. Fica comigo!", "words": [["Vou", 0.0, 0.54], ["te", 0.54, 0.66], ["contar:", 0.66, 0.96], ["essas", 1.38, 1.66], ["gotas", 1.66, 2.04], ["não", 2.04, 2.18], ["mostram", 2.18, 2.58], ["qualidade", 2.58, 3.0], ["nenhuma.", 3.0, 3.44], ["É", 3.76, 3.92], ["física", 3.92, 4.26], ["pura!", 4.26, 4.84], ["E", 5.18, 5.32], ["a", 5.32, 5.4], ["história", 5.4, 5.72], ["delas", 5.72, 6.16], ["passa", 6.16, 6.4], ["até", 6.4, 6.66], ["pela", 6.66, 6.88], ["Bíblia.", 6.88, 7.28], ["Fica", 7.64, 7.86], ["comigo!", 7.86, 8.12]], "dur": 8.724898}, {"text": "Aqui no Brasil, a gente chama de \"lágrimas\" do vinho... ou de \"pernas\". Em inglês, \"legs\": pernas. Na França, \"larmes\": lágrimas.", "words": [["Aqui", 0.0, 0.34], ["no", 0.34, 0.46], ["Brasil,", 0.46, 0.78], ["a", 0.96, 1.12], ["gente", 1.12, 1.3], ["chama", 1.3, 1.6], ["de", 1.6, 1.78], ["\"lágrimas\"", 1.78, 2.36], ["do", 2.36, 2.52], ["vinho...", 2.52, 3.16], ["ou", 3.16, 3.24], ["de", 3.24, 3.36], ["\"pernas\".", 3.36, 3.92], ["Em", 4.38, 4.56], ["inglês,", 4.56, 5.0], ["\"legs\":", 5.18, 5.78], ["pernas.", 5.96, 6.44], ["Na", 6.92, 7.08], ["França,", 7.08, 7.6], ["\"larmes\":", 7.92, 8.28], ["lágrimas.", 8.4, 8.98]], "dur": 9.404082}, {"text": "E na Alemanha? Chamam de \"janelas de igreja\"! Os arquinhos que o vinho desenha no vidro parecem os vitrais de uma catedral.", "words": [["E", 0.0, 0.18], ["na", 0.18, 0.3], ["Alemanha?", 0.3, 0.88], ["Chamam", 1.06, 1.42], ["de", 1.42, 1.58], ["\"janelas", 1.58, 2.16], ["de", 2.16, 2.36], ["igreja\"!", 2.36, 2.84], ["Os", 3.26, 3.42], ["arquinhos", 3.42, 3.8], ["que", 3.8, 3.92], ["o", 3.92, 4.02], ["vinho", 4.02, 4.18], ["desenha", 4.18, 4.66], ["no", 4.66, 4.7], ["vidro", 4.7, 5.12], ["parecem", 5.12, 5.7], ["os", 5.7, 5.8], ["vitrais", 5.8, 6.22], ["de", 6.22, 6.38], ["uma", 6.38, 6.48], ["catedral.", 6.48, 7.12]], "dur": 7.47102}, {"text": "Mas por que o vinho \"chora\"? Pra entender, a gente precisa de uma ideia só: a tensão superficial.", "words": [["Mas", 0.0, 0.32], ["por", 0.32, 0.52], ["que", 0.52, 0.72], ["o", 0.72, 0.86], ["vinho", 0.86, 1.14], ["\"chora\"?", 1.14, 1.66], ["Pra", 2.1, 2.22], ["entender,", 2.22, 2.6], ["a", 2.92, 2.94], ["gente", 2.94, 3.08], ["precisa", 3.08, 3.46], ["de", 3.46, 3.62], ["uma", 3.62, 3.72], ["ideia", 3.72, 4.0], ["só:", 4.0, 4.3], ["a", 4.74, 4.82], ["tensão", 4.82, 5.32], ["superficial.", 5.32, 5.84]], "dur": 6.661224}, {"text": "Tensão superficial é como uma pele fininha na superfície do líquido. É ela que deixa a gota redondinha... e que faz um inseto andar sobre a água.", "words": [["Tensão", 0.0, 0.52], ["superficial", 0.52, 0.94], ["é", 0.94, 1.38], ["como", 1.38, 1.56], ["uma", 1.56, 1.72], ["pele", 1.72, 1.98], ["fininha", 1.98, 2.54], ["na", 2.54, 2.66], ["superfície", 2.66, 3.28], ["do", 3.28, 3.42], ["líquido.", 3.42, 3.82], ["É", 4.16, 4.42], ["ela", 4.42, 4.64], ["que", 4.64, 4.8], ["deixa", 4.8, 5.08], ["a", 5.08, 5.28], ["gota", 5.28, 5.52], ["redondinha...", 5.52, 6.14], ["e", 6.14, 6.48], ["que", 6.48, 6.58], ["faz", 6.58, 6.8], ["um", 6.8, 6.98], ["inseto", 6.98, 7.38], ["andar", 7.38, 7.7], ["sobre", 7.7, 8.04], ["a", 8.04, 8.2], ["água.", 8.2, 8.42]], "dur": 8.698776}, {"text": "E aqui está o truque: a água tem uma pele forte, que puxa com força. O álcool tem uma pele fraca. Quanto mais água, mais forte o puxão.", "words": [["E", 0.0, 0.18], ["aqui", 0.18, 0.38], ["está", 0.38, 0.64], ["o", 0.64, 0.76], ["truque:", 0.76, 1.14], ["a", 1.38, 1.52], ["água", 1.52, 1.76], ["tem", 1.76, 1.94], ["uma", 1.94, 2.06], ["pele", 2.06, 2.32], ["forte,", 2.32, 2.76], ["que", 2.96, 3.04], ["puxa", 3.04, 3.5], ["com", 3.5, 3.66], ["força.", 3.66, 4.04], ["O", 4.32, 4.54], ["álcool", 4.54, 4.86], ["tem", 4.86, 5.1], ["uma", 5.1, 5.22], ["pele", 5.22, 5.46], ["fraca.", 5.46, 5.98], ["Quanto", 6.2, 6.56], ["mais", 6.56, 6.76], ["água,", 6.76, 7.14], ["mais", 7.4, 7.58], ["forte", 7.58, 8.02], ["o", 8.02, 8.16], ["puxão.", 8.16, 8.5]], "dur": 8.933878}, {"text": "Quando você gira a taça, fica uma película, uma camada fininha de vinho, grudada no vidro. E ali o álcool evapora, vira vapor e vai pro ar, mais rápido que a água.", "words": [["Quando", 0.0, 0.28], ["você", 0.28, 0.54], ["gira", 0.54, 0.9], ["a", 0.9, 1.02], ["taça,", 1.02, 1.46], ["fica", 1.58, 1.7], ["uma", 1.7, 1.88], ["película,", 1.88, 2.42], ["uma", 2.66, 2.78], ["camada", 2.78, 3.24], ["fininha", 3.24, 3.82], ["de", 3.82, 4.0], ["vinho,", 4.0, 4.4], ["grudada", 4.54, 5.04], ["no", 5.04, 5.22], ["vidro.", 5.22, 5.6], ["E", 5.9, 5.98], ["ali", 5.98, 6.2], ["o", 6.2, 6.56], ["álcool", 6.56, 6.88], ["evapora,", 6.88, 7.52], ["vira", 7.72, 7.98], ["vapor", 7.98, 8.32], ["e", 8.32, 8.64], ["vai", 8.64, 8.82], ["pro", 8.82, 9.02], ["ar,", 9.02, 9.22], ["mais", 9.46, 9.76], ["rápido", 9.76, 10.24], ["que", 10.24, 10.5], ["a", 10.5, 10.62], ["água.", 10.62, 10.84]], "dur": 11.128163}, {"text": "Lá em cima sobra mais água... e ela puxa mais forte! Então o vinho é puxado lá de baixo, taça acima, contra a gravidade!", "words": [["Lá", 0.0, 0.42], ["em", 0.42, 0.5], ["cima", 0.5, 0.82], ["sobra", 0.82, 1.22], ["mais", 1.22, 1.48], ["água...", 1.48, 1.88], ["e", 2.2, 2.24], ["ela", 2.24, 2.38], ["puxa", 2.38, 2.84], ["mais", 2.84, 3.1], ["forte!", 3.1, 3.58], ["Então", 4.02, 4.3], ["o", 4.3, 4.6], ["vinho", 4.6, 4.82], ["é", 4.82, 4.9], ["puxado", 4.9, 5.32], ["lá", 5.32, 5.62], ["de", 5.62, 5.78], ["baixo,", 5.78, 6.2], ["taça", 6.3, 6.74], ["acima,", 6.74, 7.22], ["contra", 7.44, 7.84], ["a", 7.84, 8.02], ["gravidade!", 8.02, 8.5]], "dur": 8.777143}, {"text": "O vinho sobe, se junta num cordão lá no alto... fica pesado demais... e cai, em gotas. Pronto: são as lágrimas!", "words": [["O", 0.0, 0.2], ["vinho", 0.2, 0.42], ["sobe,", 0.42, 0.9], ["se", 1.14, 1.36], ["junta", 1.36, 1.68], ["num", 1.68, 1.78], ["cordão", 1.78, 2.24], ["lá", 2.24, 2.4], ["no", 2.4, 2.56], ["alto...", 2.56, 3.3], ["fica", 3.3, 3.56], ["pesado", 3.56, 4.16], ["demais...", 4.16, 5.22], ["e", 5.22, 5.32], ["cai,", 5.32, 5.6], ["em", 5.86, 6.06], ["gotas.", 6.06, 6.58], ["Pronto:", 7.26, 7.64], ["são", 8.06, 8.14], ["as", 8.14, 8.34], ["lágrimas!", 8.34, 8.78]], "dur": 9.586939}, {"text": "Esse puxão tem nome: efeito Marangoni. Por causa do italiano Carlo Marangoni, que estudou isso na universidade, em mil oitocentos e sessenta e cinco.", "words": [["Esse", 0.0, 0.4], ["puxão", 0.4, 0.84], ["tem", 0.84, 1.02], ["nome:", 1.02, 1.34], ["efeito", 1.34, 2.16], ["Marangoni.", 2.16, 2.92], ["Por", 3.3, 3.56], ["causa", 3.56, 3.78], ["do", 3.78, 3.98], ["italiano", 3.98, 4.38], ["Carlo", 4.38, 4.94], ["Marangoni,", 4.94, 5.72], ["que", 5.86, 5.92], ["estudou", 5.92, 6.28], ["isso", 6.28, 6.5], ["na", 6.5, 6.66], ["universidade,", 6.66, 7.4], ["em", 7.56, 7.7], ["mil", 7.7, 7.88], ["oitocentos", 7.88, 8.6], ["e", 8.6, 8.7], ["sessenta", 8.7, 9.04], ["e", 9.04, 9.12], ["cinco.", 9.12, 9.36]], "dur": 10.083265}, {"text": "Mas dez anos antes, em mil oitocentos e cinquenta e cinco, quem explicou as lágrimas do vinho foi o engenheiro James Thomson... irmão do famoso físico Lorde Kelvin!", "words": [["Mas", 0.0, 0.14], ["dez", 0.14, 0.4], ["anos", 0.4, 0.58], ["antes,", 0.58, 0.94], ["em", 1.14, 1.24], ["mil", 1.24, 1.4], ["oitocentos", 1.4, 2.04], ["e", 2.04, 2.14], ["cinquenta", 2.14, 2.54], ["e", 2.54, 2.6], ["cinco,", 2.6, 2.88], ["quem", 3.26, 3.36], ["explicou", 3.36, 3.9], ["as", 3.9, 4.06], ["lágrimas", 4.06, 4.52], ["do", 4.52, 4.64], ["vinho", 4.64, 5.0], ["foi", 5.0, 5.3], ["o", 5.3, 5.42], ["engenheiro", 5.42, 5.94], ["James", 5.94, 6.3], ["Thomson...", 6.3, 6.98], ["irmão", 7.3, 7.7], ["do", 7.7, 7.78], ["famoso", 7.78, 8.14], ["físico", 8.14, 8.82], ["Lorde", 8.82, 9.32], ["Kelvin!", 9.32, 9.7]], "dur": 9.822041}, {"text": "E a Bíblia? No livro de Provérbios tem um aviso: não olhes para o vinho quando resplandece no copo... e se escoa suavemente.", "words": [["E", 0.0, 0.16], ["a", 0.16, 0.28], ["Bíblia?", 0.28, 0.68], ["No", 1.28, 1.44], ["livro", 1.44, 1.64], ["de", 1.64, 1.8], ["Provérbios", 1.8, 2.44], ["tem", 2.44, 2.62], ["um", 2.62, 2.74], ["aviso:", 2.74, 3.86], ["não", 3.86, 3.96], ["olhes", 3.96, 4.38], ["para", 4.38, 4.58], ["o", 4.58, 4.66], ["vinho", 4.66, 4.9], ["quando", 4.9, 5.14], ["resplandece", 5.14, 5.86], ["no", 5.86, 6.0], ["copo...", 6.0, 6.64], ["e", 6.64, 6.74], ["se", 6.74, 6.84], ["escoa", 6.84, 7.24], ["suavemente.", 7.24, 7.98]], "dur": 8.489796}, {"text": "Mais de cem anos atrás, o físico inglês Charles Boys escreveu que o versículo falava das lágrimas! Ninguém pode provar... mas faz sentido: vinho que chora muito é vinho forte.", "words": [["Mais", 0.0, 0.52], ["de", 0.52, 0.72], ["cem", 0.72, 0.98], ["anos", 0.98, 1.18], ["atrás,", 1.18, 1.52], ["o", 1.82, 1.86], ["físico", 1.86, 2.24], ["inglês", 2.24, 2.66], ["Charles", 2.66, 3.08], ["Boys", 3.08, 3.52], ["escreveu", 3.52, 4.12], ["que", 4.12, 4.22], ["o", 4.22, 4.28], ["versículo", 4.28, 4.72], ["falava", 4.72, 5.2], ["das", 5.2, 5.34], ["lágrimas!", 5.34, 5.96], ["Ninguém", 6.56, 6.92], ["pode", 6.92, 7.24], ["provar...", 7.24, 8.26], ["mas", 8.26, 8.4], ["faz", 8.4, 8.54], ["sentido:", 8.54, 9.52], ["vinho", 9.52, 9.86], ["que", 9.86, 10.04], ["chora", 10.04, 10.4], ["muito", 10.4, 10.7], ["é", 10.7, 11.1], ["vinho", 11.1, 11.38], ["forte.", 11.38, 11.62]], "dur": 12.329796}, {"text": "E a ciência ainda não acabou! Em dois mil e vinte, matemáticos da Universidade da Califórnia descobriram que o vinho sobe numa espécie de onda de choque.", "words": [["E", 0.0, 0.56], ["a", 0.56, 0.66], ["ciência", 0.66, 1.06], ["ainda", 1.06, 1.3], ["não", 1.3, 1.6], ["acabou!", 1.6, 1.92], ["Em", 2.5, 2.64], ["dois", 2.64, 2.78], ["mil", 2.78, 2.96], ["e", 2.96, 3.08], ["vinte,", 3.08, 3.4], ["matemáticos", 3.6, 4.2], ["da", 4.2, 4.36], ["Universidade", 4.36, 4.94], ["da", 4.94, 5.1], ["Califórnia", 5.1, 5.8], ["descobriram", 5.8, 6.44], ["que", 6.44, 6.58], ["o", 6.58, 6.7], ["vinho", 6.7, 6.96], ["sobe", 6.96, 7.36], ["numa", 7.36, 7.52], ["espécie", 7.52, 7.98], ["de", 7.98, 8.16], ["onda", 8.16, 8.38], ["de", 8.38, 8.56], ["choque.", 8.56, 9.06]], "dur": 9.116735}, {"text": "É uma onda que sobe pelo vidro, como uma lombada, deixando atrás uma camada mais fina. Ela é instável... e se quebra em lágrimas.", "words": [["É", 0.0, 0.16], ["uma", 0.16, 0.3], ["onda", 0.3, 0.56], ["que", 0.56, 0.74], ["sobe", 0.74, 1.18], ["pelo", 1.18, 1.38], ["vidro,", 1.38, 1.78], ["como", 1.96, 2.14], ["uma", 2.14, 2.3], ["lombada,", 2.3, 2.84], ["deixando", 3.08, 3.38], ["atrás", 3.38, 3.68], ["uma", 3.68, 3.96], ["camada", 3.96, 4.4], ["mais", 4.4, 4.6], ["fina.", 4.6, 5.4], ["Ela", 5.5, 5.72], ["é", 5.72, 5.84], ["instável...", 5.84, 6.68], ["e", 6.68, 6.86], ["se", 6.86, 6.94], ["quebra", 6.94, 7.36], ["em", 7.36, 7.56], ["lágrimas.", 7.56, 8.06]], "dur": 8.724898}, {"text": "Agora, o mito: lágrima não é sinal de vinho bom! E também não é a glicerina, uma substância meio adocicada do vinho, como muita gente fala.", "words": [["Agora,", 0.0, 0.68], ["o", 0.82, 0.84], ["mito:", 0.84, 1.14], ["lágrima", 1.5, 1.96], ["não", 1.96, 2.14], ["é", 2.14, 2.3], ["sinal", 2.3, 2.68], ["de", 2.68, 2.84], ["vinho", 2.84, 3.04], ["bom!", 3.04, 3.26], ["E", 3.68, 3.94], ["também", 3.94, 4.26], ["não", 4.26, 4.38], ["é", 4.38, 4.54], ["a", 4.54, 4.62], ["glicerina,", 4.62, 5.14], ["uma", 5.34, 5.46], ["substância", 5.46, 6.04], ["meio", 6.04, 6.26], ["adocicada", 6.26, 6.92], ["do", 6.92, 7.06], ["vinho,", 7.06, 7.4], ["como", 7.52, 7.66], ["muita", 7.66, 7.94], ["gente", 7.94, 8.18], ["fala.", 8.18, 8.52]], "dur": 8.986122}, {"text": "O que as lágrimas mostram de verdade é álcool. Mais álcool, mais lágrimas. E vinho doce escorre mais devagar, porque o açúcar deixa o vinho mais grosso.", "words": [["O", 0.0, 0.48], ["que", 0.48, 0.58], ["as", 0.58, 0.72], ["lágrimas", 0.72, 1.14], ["mostram", 1.14, 1.68], ["de", 1.68, 1.8], ["verdade", 1.8, 2.18], ["é", 2.18, 2.66], ["álcool.", 2.66, 3.02], ["Mais", 3.74, 3.88], ["álcool,", 3.88, 4.36], ["mais", 4.5, 4.8], ["lágrimas.", 4.8, 5.32], ["E", 5.86, 5.9], ["vinho", 5.9, 6.12], ["doce", 6.12, 6.56], ["escorre", 6.56, 6.96], ["mais", 6.96, 7.24], ["devagar,", 7.24, 7.76], ["porque", 8.06, 8.28], ["o", 8.28, 8.4], ["açúcar", 8.4, 8.8], ["deixa", 8.8, 9.08], ["o", 9.08, 9.24], ["vinho", 9.24, 9.44], ["mais", 9.44, 9.66], ["grosso.", 9.66, 10.16]], "dur": 10.24}, {"text": "E tem mais: a temperatura e a umidade do ar mudam a velocidade da evaporação... e mudam as lágrimas. Elas falam da sala, não da qualidade!", "words": [["E", 0.15, 0.287], ["tem", 0.287, 0.58], ["mais:", 0.58, 1.026], ["a", 1.376, 1.514], ["temperatura", 1.514, 2.425], ["e", 2.425, 2.563], ["a", 2.563, 2.7], ["umidade", 2.7, 3.302], ["do", 3.302, 3.516], ["ar", 3.516, 3.731], ["mudam", 3.731, 4.178], ["a", 4.178, 4.315], ["velocidade", 4.315, 5.149], ["da", 5.149, 5.364], ["evaporação...", 5.364, 6.43], ["e", 6.88, 7.018], ["mudam", 7.018, 7.464], ["as", 7.464, 7.679], ["lágrimas.", 7.679, 8.436], ["Elas", 8.786, 9.155], ["falam", 9.155, 9.602], ["da", 9.602, 9.817], ["sala,", 9.817, 10.264], ["não", 10.414, 10.706], ["da", 10.706, 10.921], ["qualidade!", 10.921, 11.755]], "dur": 12.255, "ESTIMADO": true}, {"text": "Quer tirar a prova em casa? Gire o vinho e tampe a taça com a mão, ou com plástico filme. Sem evaporar, as lágrimas param! Destampe... e elas recomeçam.", "words": [["Quer", 0.15, 0.52], ["tirar", 0.52, 0.966], ["a", 0.966, 1.104], ["prova", 1.104, 1.551], ["em", 1.551, 1.766], ["casa?", 1.766, 2.213], ["Gire", 2.563, 2.932], ["o", 2.932, 3.069], ["vinho", 3.069, 3.516], ["e", 3.516, 3.654], ["tampe", 3.654, 4.101], ["a", 4.101, 4.238], ["taça", 4.238, 4.608], ["com", 4.608, 4.9], ["a", 4.9, 5.037], ["mão,", 5.037, 5.407], ["ou", 5.557, 5.771], ["com", 5.771, 6.064], ["plástico", 6.064, 6.743], ["filme.", 6.743, 7.267], ["Sem", 7.617, 7.909], ["evaporar,", 7.909, 8.666], ["as", 8.816, 9.03], ["lágrimas", 9.03, 9.71], ["param!", 9.71, 10.234], ["Destampe...", 10.584, 11.495], ["e", 11.945, 12.083], ["elas", 12.083, 12.452], ["recomeçam.", 12.452, 13.286]], "dur": 13.786, "ESTIMADO": true}, {"text": "E isso vale pra toda bebida de álcool com água: vinho do Porto, uísque... e a nossa cachaça. É a mesma física!", "words": [["E", 0.15, 0.287], ["isso", 0.287, 0.657], ["vale", 0.657, 1.026], ["pra", 1.026, 1.319], ["toda", 1.319, 1.688], ["bebida", 1.688, 2.213], ["de", 2.213, 2.427], ["álcool", 2.427, 2.952], ["com", 2.952, 3.244], ["água:", 3.244, 3.691], ["vinho", 4.041, 4.488], ["do", 4.488, 4.702], ["Porto,", 4.702, 5.227], ["uísque...", 5.377, 6.133], ["e", 6.583, 6.721], ["a", 6.721, 6.858], ["nossa", 6.858, 7.305], ["cachaça.", 7.305, 7.984], ["É", 8.334, 8.471], ["a", 8.471, 8.609], ["mesma", 8.609, 9.056], ["física!", 9.056, 9.657]], "dur": 10.157, "ESTIMADO": true}, {"text": "Resumindo: lágrima é física, não qualidade. Mostra álcool, açúcar e o clima da sala. E quem explicou primeiro foi Thomson; o nome ficou com Marangoni!", "words": [["Resumindo:", 0.15, 0.984], ["lágrima", 1.334, 1.936], ["é", 1.936, 2.073], ["física,", 2.073, 2.675], ["não", 2.825, 3.117], ["qualidade.", 3.117, 3.951], ["Mostra", 4.301, 4.825], ["álcool,", 4.825, 5.427], ["açúcar", 5.577, 6.101], ["e", 6.101, 6.238], ["o", 6.238, 6.376], ["clima", 6.376, 6.823], ["da", 6.823, 7.038], ["sala.", 7.038, 7.484], ["E", 7.834, 7.972], ["quem", 7.972, 8.341], ["explicou", 8.341, 9.02], ["primeiro", 9.02, 9.7], ["foi", 9.7, 9.992], ["Thomson;", 9.992, 10.671], ["o", 10.821, 10.958], ["nome", 10.958, 11.328], ["ficou", 11.328, 11.775], ["com", 11.775, 12.067], ["Marangoni!", 12.067, 12.901]], "dur": 13.401, "ESTIMADO": true}, {"text": "Curtiu? Se inscreve no canal e me conta: qual mito do vinho você quer que eu desmonte no próximo vídeo?", "words": [["Curtiu?", 0.15, 0.752], ["Se", 1.102, 1.316], ["inscreve", 1.316, 1.996], ["no", 1.996, 2.21], ["canal", 2.21, 2.657], ["e", 2.657, 2.795], ["me", 2.795, 3.009], ["conta:", 3.009, 3.534], ["qual", 3.884, 4.253], ["mito", 4.253, 4.623], ["do", 4.623, 4.838], ["vinho", 4.838, 5.285], ["você", 5.285, 5.654], ["quer", 5.654, 6.024], ["que", 6.024, 6.316], ["eu", 6.316, 6.531], ["desmonte", 6.531, 7.21], ["no", 7.21, 7.424], ["próximo", 7.424, 8.026], ["vídeo?", 8.026, 8.55]], "dur": 9.05, "ESTIMADO": true}, {"text": "Wine Know. Dark Divino.", "words": [["Wine", 0.08, 0.4], ["Know.", 0.448, 1.04], ["Dark", 1.12, 1.44], ["Divino.", 1.5, 2.0]], "dur": 2.037551}]