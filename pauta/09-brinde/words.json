[{"text": "Por que, antes de beber, a gente levanta a taça... bate uma na outra... e fala \"saúde\"? De onde veio essa mania?", "words": [["Por", 0.065, 0.08], ["que,", 0.14, 0.4], ["antes", 0.44, 0.64], ["de", 0.693, 0.8], ["beber,", 0.827, 1.36], ["a", 1.4, 1.44], ["gente", 1.48, 1.68], ["levanta", 1.74, 2.16], ["a", 2.24, 2.32], ["taça...", 2.373, 3.04], ["bate", 3.12, 3.36], ["uma", 3.42, 3.6], ["na", 3.653, 3.76], ["outra...", 3.813, 4.32], ["e", 4.36, 4.4], ["fala", 4.44, 4.72], ["\"saúde\"?", 4.84, 5.44], ["De", 5.627, 6.0], ["onde", 6.048, 6.24], ["veio", 6.293, 6.48], ["essa", 6.512, 6.64], ["mania?", 6.7, 7.12]], "dur": 7.4350000000000005}, {"text": "É uma história de três mil anos: tem deuses gregos, imperador romano, soldado alemão... e muita lenda. Fica comigo!", "words": [["É", 0.3149999999999995, 0.3249999999999993], ["uma", 0.3649999999999993, 0.48499999999999943], ["história", 0.5209999999999999, 0.8049999999999997], ["de", 0.8579999999999988, 0.9649999999999999], ["três", 1.045, 1.3650000000000002], ["mil", 1.424999999999999, 1.6049999999999986], ["anos:", 1.6849999999999987, 2.4049999999999994], ["tem", 2.4450000000000003, 2.5649999999999995], ["deuses", 2.6180000000000003, 2.965], ["gregos,", 3.004999999999999, 3.6849999999999987], ["imperador", 3.7249999999999996, 4.164999999999999], ["romano,", 4.225, 4.885], ["soldado", 4.965, 5.445], ["alemão...", 5.484999999999999, 6.164999999999999], ["e", 6.205, 6.244999999999999], ["muita", 6.324999999999999, 6.725], ["lenda.", 6.764999999999999, 7.525], ["Fica", 7.5649999999999995, 7.764999999999999], ["comigo!", 7.805, 8.245]], "dur": 8.750000000000002}, {"text": "Antes do brinde, existia a libação. Na Grécia antiga, antes de beber, derramava-se um pouco de vinho no chão, como presente aos deuses.", "words": [["Antes", 0.504999999999999, 0.6949999999999967], ["do", 0.7219999999999978, 0.7749999999999986], ["brinde,", 0.8279999999999994, 1.254999999999999], ["existia", 1.3219999999999992, 1.7349999999999994], ["a", 1.7749999999999986, 1.8149999999999977], ["libação.", 1.8749999999999964, 2.5349999999999966], ["Na", 2.7749999999999986, 3.254999999999999], ["Grécia", 3.3079999999999963, 3.5749999999999993], ["antiga,", 3.6149999999999984, 4.214999999999996], ["antes", 4.267999999999997, 4.534999999999997], ["de", 4.561999999999998, 4.614999999999998], ["beber,", 4.667999999999999, 5.174999999999997], ["derramava-se", 5.214999999999996, 5.814999999999998], ["um", 5.841999999999999, 5.894999999999996], ["pouco", 5.961999999999996, 6.294999999999998], ["de", 6.347999999999999, 6.454999999999998], ["vinho", 6.494999999999997, 6.694999999999997], ["no", 6.721999999999998, 6.774999999999999], ["chão,", 6.827999999999999, 7.174999999999997], ["como", 7.254999999999999, 7.574999999999999], ["presente", 7.618999999999996, 7.974999999999998], ["aos", 8.014999999999997, 8.134999999999998], ["deuses.", 8.187999999999999, 8.774999999999999]], "dur": 8.814183999999997}, {"text": "Era um jeito de agradecer, e de pedir proteção, antes da festa. O primeiro gole era dos deuses!", "words": [["Era", 0.13, 0.16], ["um", 0.187, 0.24], ["jeito", 0.293, 0.48], ["de", 0.507, 0.56], ["agradecer,", 0.6, 1.28], ["e", 1.44, 1.6], ["de", 1.627, 1.68], ["pedir", 1.72, 2.0], ["proteção,", 2.053, 2.8], ["antes", 2.853, 3.12], ["da", 3.147, 3.2], ["festa.", 3.28, 3.76], ["O", 4.0, 4.24], ["primeiro", 4.284, 4.64], ["gole", 4.72, 5.04], ["era", 5.12, 5.36], ["dos", 5.42, 5.6], ["deuses!", 5.68, 6.72]], "dur": 6.7545}, {"text": "Em Roma, beber à saúde virou costume nos banquetes. O poeta Ovídio registrou o brinde: \"saúde a vocês... e saúde a ti, César!\"", "words": [["Em", 0.03449999999999953, 0.04549999999999965], ["Roma,", 0.12549999999999972, 0.5255000000000001], ["beber", 0.5785, 0.8454999999999995], ["à", 0.9654999999999996, 1.0854999999999997], ["saúde", 1.1254999999999997, 1.3255], ["virou", 1.365499999999999, 1.5655000000000001], ["costume", 1.6255000000000006, 2.0455000000000005], ["nos", 2.0655, 2.1255000000000006], ["banquetes.", 2.1854999999999993, 3.0054999999999996], ["O", 3.1654999999999998, 3.3255], ["poeta", 3.378499999999999, 3.7255000000000003], ["Ovídio", 3.8055000000000003, 4.205500000000001], ["registrou", 4.262499999999999, 4.685499999999999], ["o", 4.7255, 4.765499999999999], ["brinde:", 4.7925, 5.4055], ["\"saúde", 5.525499999999999, 6.0455000000000005], ["a", 6.1655, 6.285499999999999], ["vocês...", 6.333499999999999, 7.0055], ["e", 7.125500000000001, 7.2455], ["saúde", 7.285499999999999, 7.4855], ["a", 7.525499999999999, 7.5655], ["ti,", 7.6455, 7.8855], ["César!\"", 7.9254999999999995, 8.7655]], "dur": 8.7955}, {"text": "E a palavra brinde? Ela nem é portuguesa! Vem do alemão: \"bring dir's\", que quer dizer \"eu te ofereço\".", "words": [["E", 0.02999999999999936, 0.036999999999999034], ["a", 0.04299999999999926, 0.049999999999998934], ["palavra", 0.09999999999999964, 0.4499999999999993], ["brinde?", 0.5299999999999976, 1.3299999999999983], ["Ela", 1.3829999999999991, 1.5700000000000003], ["nem", 1.629999999999999, 1.8099999999999987], ["é", 1.8900000000000006, 1.9699999999999989], ["portuguesa!", 2.0180000000000007, 2.8099999999999987], ["Vem", 2.9499999999999993, 3.25], ["do", 3.277000000000001, 3.3299999999999983], ["alemão:", 3.370000000000001, 4.129999999999999], ["\"bring", 4.169999999999998, 4.449999999999999], ["dir's\",", 4.503, 5.09], ["que", 5.129999999999999, 5.25], ["quer", 5.297999999999998, 5.489999999999998], ["dizer", 5.529999999999998, 5.809999999999999], ["\"eu", 5.969999999999999, 6.210000000000001], ["te", 6.262999999999998, 6.370000000000001], ["ofereço\".", 6.422999999999998, 7.329999999999998]], "dur": 7.359387999999999}, {"text": "A explicação mais aceita liga a expressão aos soldados alemães que lutavam pela Europa nos anos mil e quinhentos. Daí veio o \"brindis\" espanhol, o \"brindisi\" italiano... e o nosso brinde!", "words": [["A", 0.3, 0.333], ["explicação", 0.343, 0.56], ["mais", 0.608, 0.8], ["aceita", 0.88, 1.28], ["liga", 1.36, 1.6], ["a", 1.64, 1.68], ["expressão", 1.73, 2.24], ["aos", 2.3, 2.48], ["soldados", 2.512, 2.88], ["alemães", 2.92, 3.36], ["que", 3.38, 3.44], ["lutavam", 3.48, 3.84], ["pela", 3.872, 4.0], ["Europa", 4.057, 4.4], ["nos", 4.46, 4.64], ["anos", 4.688, 4.88], ["mil", 4.92, 5.04], ["e", 5.12, 5.2], ["quinhentos.", 5.227, 6.32], ["Daí", 6.373, 6.56], ["veio", 6.613, 6.88], ["o", 6.92, 6.96], ["\"brindis\"", 7.0, 7.52], ["espanhol,", 7.547, 7.92], ["o", 8.12, 8.32], ["\"brindisi\"", 8.36, 9.04], ["italiano...", 9.102, 10.0], ["e", 10.04, 10.08], ["o", 10.18, 10.28], ["nosso", 10.313, 10.48], ["brinde!", 10.507, 10.96]], "dur": 11.34}, {"text": "Já em inglês, brinde é \"toast\": torrada! Punham pão torrado com especiarias dentro do vinho. Até Shakespeare escreveu isso.", "words": [["Já", 0.3800000000000008, 0.41999999999999993], ["em", 0.47300000000000075, 0.5800000000000001], ["inglês,", 0.6280000000000001, 1.3000000000000007], ["brinde", 1.3800000000000008, 1.8599999999999994], ["é", 1.9800000000000004, 2.0999999999999996], ["\"toast\":", 2.1799999999999997, 3.0600000000000005], ["torrada!", 3.0999999999999996, 3.620000000000001], ["Punham", 3.7799999999999994, 4.42], ["pão", 4.460000000000001, 4.58], ["torrado", 4.640000000000001, 5.140000000000001], ["com", 5.16, 5.219999999999999], ["especiarias", 5.286999999999999, 6.02], ["dentro", 6.0539999999999985, 6.260000000000002], ["do", 6.312999999999999, 6.420000000000002], ["vinho.", 6.48, 7.02], ["Até", 7.1129999999999995, 7.379999999999999], ["Shakespeare", 7.5, 8.02], ["escreveu", 8.059999999999999, 8.5], ["isso.", 8.564, 9.14]], "dur": 9.335}, {"text": "E bater as taças? Você já ouviu a história do veneno?", "words": [["E", 0.19500000000000028, 0.2049999999999983], ["bater", 0.245000000000001, 0.5249999999999986], ["as", 0.5779999999999994, 0.6849999999999987], ["taças?", 0.7379999999999995, 1.1649999999999991], ["Você", 1.3249999999999993, 1.9649999999999999], ["já", 1.9920000000000009, 2.044999999999998], ["ouviu", 2.097999999999999, 2.3649999999999984], ["a", 2.4049999999999976, 2.4450000000000003], ["história", 2.4890000000000008, 2.844999999999999], ["do", 2.872, 2.9250000000000007], ["veneno?", 2.965, 3.4049999999999976]], "dur": 3.932347}, {"text": "Dizem que, na Idade Média, batiam os copos com força pro vinho de um pular no copo do outro. Se tivesse veneno... os dois bebiam.", "words": [["Dizem", 0.12, 0.4], ["que,", 0.42, 0.52], ["na", 0.533, 0.56], ["Idade", 0.64, 0.96], ["Média,", 1.04, 1.52], ["batiam", 1.58, 1.92], ["os", 1.973, 2.08], ["copos", 2.14, 2.4], ["com", 2.44, 2.56], ["força", 2.64, 3.04], ["pro", 3.1, 3.28], ["vinho", 3.32, 3.52], ["de", 3.6, 3.76], ["um", 3.787, 3.84], ["pular", 3.92, 4.24], ["no", 4.293, 4.4], ["copo", 4.48, 4.8], ["do", 4.827, 4.88], ["outro.", 4.933, 5.44], ["Se", 5.52, 5.68], ["tivesse", 5.72, 6.08], ["veneno...", 6.14, 6.88], ["os", 6.933, 7.04], ["dois", 7.088, 7.28], ["bebiam.", 7.32, 7.76]], "dur": 8.076}, {"text": "Só que não existe nenhuma prova disso! É lenda. O tim-tim ficou na moda lá pelos anos mil e seiscentos, quando o vidro passou a fazer aquele som bonito.", "words": [["Só", 0.31599999999999895, 0.4039999999999999], ["que", 0.4239999999999995, 0.484], ["não", 0.5239999999999991, 0.6440000000000001], ["existe", 0.7009999999999987, 1.0439999999999987], ["nenhuma", 1.0839999999999996, 1.363999999999999], ["prova", 1.443999999999999, 1.8439999999999994], ["disso!", 1.9239999999999995, 2.404], ["É", 2.484, 2.564], ["lenda.", 2.603999999999999, 3.1639999999999997], ["O", 3.2639999999999993, 3.363999999999999], ["tim-tim", 3.404, 3.7639999999999993], ["ficou", 3.783999999999999, 4.004], ["na", 4.056999999999999, 4.164], ["moda", 4.228, 4.484], ["lá", 4.536999999999999, 4.644], ["pelos", 4.683999999999999, 4.884], ["anos", 4.931999999999999, 5.123999999999999], ["mil", 5.183999999999999, 5.363999999999999], ["e", 5.404, 5.443999999999999], ["seiscentos,", 5.491999999999999, 6.244], ["quando", 6.277999999999999, 6.484], ["o", 6.543999999999999, 6.603999999999999], ["vidro", 6.634, 6.884], ["passou", 6.916, 7.123999999999999], ["a", 7.164, 7.203999999999999], ["fazer", 7.257, 7.523999999999999], ["aquele", 7.555999999999999, 7.763999999999999], ["som", 7.843999999999999, 8.084], ["bonito.", 8.123999999999999, 8.884]], "dur": 8.951999999999998}, {"text": "Tem até quem diga que o som completa os cinco sentidos: você vê, cheira, segura, prova... e escuta!", "words": [["Tem", 0.06800000000000139, 0.0920000000000023], ["até", 0.13200000000000145, 0.25200000000000244], ["quem", 0.3000000000000007, 0.4920000000000009], ["diga", 0.5519999999999996, 0.7320000000000029], ["que", 0.772000000000002, 0.892000000000003], ["o", 0.9320000000000022, 0.9720000000000013], ["som", 1.0519999999999996, 1.2920000000000016], ["completa", 1.3450000000000024, 1.772000000000002], ["os", 1.8250000000000028, 1.9320000000000022], ["cinco", 1.9720000000000013, 2.1720000000000006], ["sentidos:", 2.2200000000000024, 3.0519999999999996], ["você", 3.1159999999999997, 3.372], ["vê,", 3.4520000000000017, 3.932000000000002], ["cheira,", 3.992000000000001, 4.652000000000001], ["segura,", 4.712, 5.452000000000002], ["prova...", 5.532, 6.172000000000001], ["e", 6.212, 6.2520000000000024], ["escuta!", 6.312000000000001, 7.052]], "dur": 7.083020000000001}, {"text": "E aqui no Brasil? A gente fala \"saúde\"... e \"tim-tim\", imitando o barulhinho das taças.", "words": [["E", 0.07, 0.08], ["aqui", 0.128, 0.32], ["no", 0.373, 0.48], ["Brasil?", 0.549, 1.12], ["A", 1.2, 1.28], ["gente", 1.32, 1.52], ["fala", 1.6, 1.92], ["\"saúde\"...", 2.04, 3.12], ["e", 3.16, 3.2], ["\"tim-tim\",", 3.24, 3.68], ["imitando", 3.813, 4.4], ["o", 4.44, 4.48], ["barulhinho", 4.5, 4.88], ["das", 4.92, 5.04], ["taças.", 5.12, 5.68]], "dur": 5.915}, {"text": "E tem superstição pra todo lado: brindar com o copo vazio? Dizem que dá azar!", "words": [["E", 0.23500000000000032, 0.2450000000000001], ["tem", 0.3049999999999997, 0.4850000000000003], ["superstição", 0.5449999999999999, 1.205], ["pra", 1.2249999999999996, 1.2850000000000001], ["todo", 1.3490000000000002, 1.6049999999999995], ["lado:", 1.6849999999999996, 2.245], ["brindar", 2.2719999999999994, 2.6450000000000005], ["com", 2.665, 2.7250000000000005], ["o", 2.7649999999999997, 2.8050000000000006], ["copo", 2.8649999999999993, 3.124999999999999], ["vazio?", 3.165, 3.5249999999999995], ["Dizem", 3.7250000000000005, 4.165], ["que", 4.185, 4.245], ["dá", 4.297999999999999, 4.405], ["azar!", 4.485, 4.805000000000001]], "dur": 5.04}, {"text": "E olhar nos olhos? Tem gente que jura que, se não olhar, a vida amorosa esfria! É crendice... mas não custa olhar, né?", "words": [["E", 0.23499999999999943, 0.24499999999999922], ["olhar", 0.29800000000000004, 0.5649999999999995], ["nos", 0.625, 0.8049999999999997], ["olhos?", 0.8849999999999998, 1.2850000000000001], ["Tem", 1.3650000000000002, 1.6050000000000004], ["gente", 1.6579999999999995, 1.9250000000000007], ["que", 1.9649999999999999, 2.084999999999999], ["jura", 2.164999999999999, 2.4049999999999994], ["que,", 2.4450000000000003, 2.6449999999999996], ["se", 2.6720000000000006, 2.7249999999999996], ["não", 2.7650000000000006, 2.885], ["olhar,", 2.9380000000000006, 3.4450000000000003], ["a", 3.4849999999999994, 3.5250000000000004], ["vida", 3.5730000000000004, 3.7650000000000006], ["amorosa", 3.8130000000000006, 4.244999999999999], ["esfria!", 4.298, 4.725], ["É", 4.925000000000001, 5.124999999999998], ["crendice...", 5.165000000000001, 6.005000000000001], ["mas", 6.045, 6.165000000000001], ["não", 6.205, 6.325000000000001], ["custa", 6.372999999999999, 6.645000000000001], ["olhar,", 6.671999999999999, 6.965000000000002], ["né?", 7.017999999999999, 7.365]], "dur": 7.409082}, {"text": "E o gole pro santo: derramar um pouquinho da cachaça no chão antes de beber. Repara: é quase a libação dos gregos, três mil anos depois!", "words": [["E", 0.07, 0.08], ["o", 0.12, 0.16], ["gole", 0.213, 0.48], ["pro", 0.52, 0.64], ["santo:", 0.68, 1.2], ["derramar", 1.24, 1.6], ["um", 1.627, 1.68], ["pouquinho", 1.74, 2.08], ["da", 2.133, 2.24], ["cachaça", 2.28, 2.72], ["no", 2.773, 2.88], ["chão", 2.933, 3.2], ["antes", 3.253, 3.52], ["de", 3.547, 3.6], ["beber.", 3.653, 4.4], ["Repara:", 4.5, 5.2], ["é", 5.28, 5.36], ["quase", 5.387, 5.6], ["a", 5.64, 5.68], ["libação", 5.72, 6.16], ["dos", 6.22, 6.4], ["gregos,", 6.44, 6.96], ["três", 7.024, 7.28], ["mil", 7.34, 7.52], ["anos", 7.568, 7.76], ["depois!", 7.84, 8.4]], "dur": 8.8325}, {"text": "Lá fora também tem: nas marinhas inglesa e americana, nunca se brinda com água. Dizem que o homenageado pode morrer afogado!", "words": [["Lá", 0.432500000000001, 0.6125000000000007], ["fora", 0.6445000000000007, 0.7725000000000009], ["também", 0.8185000000000002, 1.0925000000000011], ["tem:", 1.1524999999999999, 1.8125], ["nas", 1.852500000000001, 1.9725000000000001], ["marinhas", 2.025500000000001, 2.3725000000000005], ["inglesa", 2.4124999999999996, 2.772500000000001], ["e", 2.8125, 2.852500000000001], ["americana,", 2.8985000000000003, 3.7325], ["nunca", 3.7855000000000008, 4.0525], ["se", 4.105500000000001, 4.2125], ["brinda", 4.265500000000001, 4.532500000000001], ["com", 4.5725, 4.692500000000001], ["água.", 4.772500000000001, 5.3725000000000005], ["Dizem", 5.512500000000001, 5.8925], ["que", 5.9125, 5.9725], ["o", 6.012500000000001, 6.0525], ["homenageado", 6.092500000000001, 6.772500000000001], ["pode", 6.820500000000001, 7.012500000000001], ["morrer", 7.0725, 7.3325], ["afogado!", 7.3855, 7.9725]], "dur": 8.4345}, {"text": "Agora, a dica de quem entende: bata as taças pela parte larga, o bojo. A borda é a parte mais fina, e a que mais quebra.", "words": [["Agora,", 0.46199999999999974, 0.8180000000000014], ["a", 0.8580000000000005, 0.8979999999999997], ["dica", 0.9780000000000015, 1.218], ["de", 1.2710000000000008, 1.3780000000000001], ["quem", 1.4100000000000001, 1.5380000000000003], ["entende:", 1.5779999999999994, 2.338000000000001], ["bata", 2.378, 2.5779999999999994], ["as", 2.6310000000000002, 2.7379999999999995], ["taças", 2.8180000000000014, 3.1380000000000017], ["pela", 3.186, 3.378], ["parte", 3.431000000000001, 3.6980000000000004], ["larga,", 3.7780000000000022, 4.338000000000001], ["o", 4.417999999999999, 4.498000000000001], ["bojo.", 4.577999999999999, 5.178000000000001], ["A", 5.278000000000002, 5.378], ["borda", 5.442, 5.7379999999999995], ["é", 5.757999999999999, 5.778000000000002], ["a", 5.818000000000001, 5.8580000000000005], ["parte", 5.911000000000001, 6.178000000000001], ["mais", 6.225999999999999, 6.417999999999999], ["fina,", 6.4780000000000015, 6.9780000000000015], ["e", 7.018000000000001, 7.058], ["a", 7.118000000000002, 7.178000000000001], ["que", 7.208000000000002, 7.298000000000002], ["mais", 7.346, 7.538], ["quebra.", 7.597999999999999, 8.258]], "dur": 8.280755}, {"text": "Resumindo: o brinde nasceu com os gregos, a palavra veio do alemão, o tim-tim é som de amizade... e a história do veneno é lenda!", "words": [["Resumindo:", 0.136, 0.72], ["o", 0.76, 0.8], ["brinde", 0.853, 1.12], ["nasceu", 1.16, 1.44], ["com", 1.48, 1.6], ["os", 1.627, 1.68], ["gregos,", 1.72, 2.24], ["a", 2.28, 2.32], ["palavra", 2.38, 2.8], ["veio", 2.853, 3.04], ["do", 3.067, 3.12], ["alemão,", 3.16, 3.68], ["o", 3.76, 3.84], ["tim-tim", 3.9, 4.4], ["é", 4.44, 4.48], ["som", 4.56, 4.8], ["de", 4.827, 4.88], ["amizade...", 4.907, 5.6], ["e", 5.64, 5.68], ["a", 5.8, 5.92], ["história", 5.947, 6.16], ["do", 6.187, 6.24], ["veneno", 6.3, 6.64], ["é", 6.72, 6.8], ["lenda!", 6.84, 7.28]], "dur": 7.568}, {"text": "Curtiu? Se inscreve no canal e me conta: qual curiosidade do vinho você quer no próximo vídeo?", "words": [["Curtiu?", 0.28800000000000026, 0.7119999999999997], ["Se", 0.7789999999999999, 0.9120000000000008], ["inscreve", 0.9320000000000004, 1.232000000000001], ["no", 1.2850000000000001, 1.3920000000000012], ["canal", 1.4320000000000004, 1.6319999999999997], ["e", 1.6720000000000006, 1.7119999999999997], ["me", 1.7650000000000006, 1.8719999999999999], ["conta:", 1.9250000000000007, 2.5920000000000005], ["qual", 2.6240000000000006, 2.7520000000000007], ["curiosidade", 2.792, 3.3920000000000012], ["do", 3.4450000000000003, 3.5519999999999996], ["vinho", 3.612, 3.872], ["você", 3.936, 4.192], ["quer", 4.224, 4.352], ["no", 4.405000000000001, 4.5120000000000005], ["próximo", 4.572000000000001, 4.992000000000001], ["vídeo?", 5.059000000000001, 5.4719999999999995]], "dur": 5.519347}, {"text": "Wine Know. Dark Divino.", "words": [["Wine", 0.064, 0.32], ["Know.", 0.384, 1.0], ["Dark", 1.072, 1.36], ["Divino.", 1.44, 2.0]], "dur": 2.037551}]