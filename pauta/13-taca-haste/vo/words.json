[{"text": "Por que a taça de vinho tem esse cabinho fino, a haste? E por que mandam segurar por ela?", "words": [["Por", 0.0, 0.3], ["que", 0.3, 0.38], ["a", 0.38, 0.48], ["taça", 0.48, 0.78], ["de", 0.78, 0.96], ["vinho", 0.96, 1.12], ["tem", 1.12, 1.3], ["esse", 1.3, 1.52], ["cabinho", 1.52, 1.94], ["fino,", 1.94, 2.26], ["a", 2.5, 2.62], ["haste?", 2.62, 3.04], ["E", 3.22, 3.34], ["por", 3.34, 3.44], ["que", 3.44, 3.6], ["mandam", 3.6, 3.88], ["segurar", 3.88, 4.3], ["por", 4.3, 4.54], ["ela?", 4.54, 4.68]], "dur": 5.067755}, {"text": "Tem grego, vidreiro de Veneza, imposto inglês... e uma câmera que enxerga o álcool! Fica comigo!", "words": [["Tem", 0.0, 0.54], ["grego,", 0.54, 1.06], ["vidreiro", 1.3, 1.66], ["de", 1.66, 1.86], ["Veneza,", 1.86, 2.3], ["imposto", 2.56, 2.9], ["inglês...", 2.9, 3.7], ["e", 3.7, 3.84], ["uma", 3.84, 4.1], ["câmera", 4.1, 4.42], ["que", 4.42, 4.68], ["enxerga", 4.68, 5.14], ["o", 5.14, 5.32], ["álcool!", 5.32, 5.62], ["Fica", 5.9, 6.06], ["comigo!", 6.06, 6.4]], "dur": 6.870204}, {"text": "Na Grécia antiga, o vinho ia numa kylix: uma taça de barro, larga e rasinha... com um pezinho embaixo. O pé já estava lá!", "words": [["Na", 0.0, 0.62], ["Grécia", 0.62, 0.94], ["antiga,", 0.94, 1.4], ["o", 1.56, 1.68], ["vinho", 1.68, 1.84], ["ia", 1.84, 2.04], ["numa", 2.04, 2.3], ["kylix:", 2.3, 2.92], ["uma", 3.4, 3.66], ["taça", 3.66, 3.98], ["de", 3.98, 4.24], ["barro,", 4.24, 4.78], ["larga", 5.02, 5.16], ["e", 5.16, 5.3], ["rasinha...", 5.3, 6.0], ["com", 6.0, 6.18], ["um", 6.18, 6.36], ["pezinho", 6.36, 6.64], ["embaixo.", 6.64, 7.06], ["O", 7.44, 7.62], ["pé", 7.62, 7.76], ["já", 7.76, 8.16], ["estava", 8.16, 8.42], ["lá!", 8.42, 8.58]], "dur": 8.646531}, {"text": "Depois veio o vidro soprado: o vidreiro sopra o vidro derretido num tubo, feito balão. E os romanos fizeram as primeiras taças de vidro com haste.", "words": [["Depois", 0.0, 0.6], ["veio", 0.6, 0.84], ["o", 0.84, 1.08], ["vidro", 1.08, 1.26], ["soprado:", 1.26, 2.06], ["o", 2.34, 2.46], ["vidreiro", 2.46, 2.86], ["sopra", 2.86, 3.22], ["o", 3.22, 3.42], ["vidro", 3.42, 3.64], ["derretido", 3.64, 4.12], ["num", 4.12, 4.32], ["tubo,", 4.32, 4.78], ["feito", 4.92, 5.06], ["balão.", 5.06, 5.46], ["E", 5.96, 6.08], ["os", 6.08, 6.24], ["romanos", 6.24, 6.66], ["fizeram", 6.66, 7.06], ["as", 7.06, 7.22], ["primeiras", 7.22, 7.68], ["taças", 7.68, 8.02], ["de", 8.02, 8.26], ["vidro", 8.26, 8.5], ["com", 8.5, 8.7], ["haste.", 8.7, 9.06]], "dur": 9.404082}, {"text": "Só que, na Idade Média, vidro era luxo! O povo bebia em madeira, chifre, barro ou estanho, um metal parecido com prata.", "words": [["Só", 0.0, 0.48], ["que,", 0.48, 0.64], ["na", 0.68, 0.7], ["Idade", 0.7, 1.04], ["Média,", 1.04, 1.48], ["vidro", 1.8, 2.0], ["era", 2.0, 2.22], ["luxo!", 2.22, 2.8], ["O", 3.04, 3.14], ["povo", 3.14, 3.34], ["bebia", 3.34, 3.7], ["em", 3.7, 3.9], ["madeira,", 3.9, 4.38], ["chifre,", 4.66, 5.06], ["barro", 5.44, 5.66], ["ou", 5.66, 5.94], ["estanho,", 5.94, 6.42], ["um", 6.58, 6.72], ["metal", 6.72, 6.88], ["parecido", 6.88, 7.38], ["com", 7.38, 7.64], ["prata.", 7.64, 7.84]], "dur": 8.254694}, {"text": "Quem mudou isso foi Veneza: em mil duzentos e noventa e um, levou os fornos de vidro pra ilha de Murano. Pra evitar incêndio... e guardar o segredo!", "words": [["Quem", 0.0, 0.6], ["mudou", 0.6, 0.96], ["isso", 0.96, 1.24], ["foi", 1.24, 1.44], ["Veneza:", 1.44, 2.04], ["em", 2.4, 2.5], ["mil", 2.5, 2.72], ["duzentos", 2.72, 3.24], ["e", 3.24, 3.3], ["noventa", 3.3, 3.72], ["e", 3.72, 3.74], ["um,", 3.74, 4.06], ["levou", 4.3, 4.48], ["os", 4.48, 4.66], ["fornos", 4.66, 4.94], ["de", 4.94, 5.14], ["vidro", 5.14, 5.44], ["pra", 5.44, 5.6], ["ilha", 5.6, 5.84], ["de", 5.84, 6.04], ["Murano.", 6.04, 6.62], ["Pra", 6.82, 6.98], ["evitar", 6.98, 7.32], ["incêndio...", 7.32, 8.22], ["e", 8.22, 8.34], ["guardar", 8.34, 8.88], ["o", 8.88, 9.12], ["segredo!", 9.12, 9.44]], "dur": 9.508571}, {"text": "Nos anos mil e quatrocentos, Murano inventou o cristallo: um vidro quase transparente, que esticava feito caramelo. Nasciam as taças de haste alta!", "words": [["Nos", 0.0, 0.24], ["anos", 0.24, 0.54], ["mil", 0.54, 0.7], ["e", 0.7, 0.94], ["quatrocentos,", 0.94, 1.66], ["Murano", 1.84, 2.06], ["inventou", 2.06, 2.5], ["o", 2.5, 2.64], ["cristallo:", 2.64, 3.12], ["um", 3.48, 3.58], ["vidro", 3.58, 3.9], ["quase", 3.9, 4.28], ["transparente,", 4.28, 4.94], ["que", 5.02, 5.12], ["esticava", 5.12, 5.6], ["feito", 5.6, 5.92], ["caramelo.", 5.92, 6.72], ["Nasciam", 7.02, 7.34], ["as", 7.34, 7.66], ["taças", 7.66, 8.02], ["de", 8.02, 8.24], ["haste", 8.24, 8.64], ["alta!", 8.64, 8.82]], "dur": 9.377959}, {"text": "E o cristal pesado e brilhante? Esse é inglês! Nos anos mil seiscentos e setenta, George Ravenscroft fez um vidro com chumbo, que a Europa inteira copiou.", "words": [["E", 0.0, 0.16], ["o", 0.16, 0.34], ["cristal", 0.34, 0.72], ["pesado", 0.72, 1.2], ["e", 1.2, 1.38], ["brilhante?", 1.38, 2.02], ["Esse", 2.32, 2.58], ["é", 2.58, 2.76], ["inglês!", 2.76, 3.32], ["Nos", 3.6, 3.7], ["anos", 3.7, 4.02], ["mil", 4.02, 4.3], ["seiscentos", 4.3, 4.82], ["e", 4.82, 4.96], ["setenta,", 4.96, 5.42], ["George", 5.76, 6.26], ["Ravenscroft", 6.26, 6.88], ["fez", 6.88, 7.14], ["um", 7.14, 7.34], ["vidro", 7.34, 7.6], ["com", 7.6, 7.9], ["chumbo,", 7.9, 8.24], ["que", 8.32, 8.42], ["a", 8.42, 8.56], ["Europa", 8.56, 8.78], ["inteira", 8.78, 9.24], ["copiou.", 9.24, 9.68]], "dur": 10.13551}, {"text": "Uns setenta anos depois, a Inglaterra criou um imposto sobre o vidro... cobrado pelo peso! E durou cem anos!", "words": [["Uns", 0.0, 0.26], ["setenta", 0.26, 0.76], ["anos", 0.76, 0.98], ["depois,", 0.98, 1.5], ["a", 1.7, 1.82], ["Inglaterra", 1.82, 2.32], ["criou", 2.32, 2.6], ["um", 2.6, 2.82], ["imposto", 2.82, 3.16], ["sobre", 3.16, 3.4], ["o", 3.4, 3.62], ["vidro...", 3.62, 4.12], ["cobrado", 4.12, 4.64], ["pelo", 4.64, 4.84], ["peso!", 4.84, 5.22], ["E", 5.56, 5.72], ["durou", 5.72, 6.1], ["cem", 6.1, 6.4], ["anos!", 6.4, 6.7]], "dur": 6.844082}, {"text": "Resultado? Taças menores e mais leves. E nessa época surgiu o air twist: uma bolha de ar torcida dentro da haste, como um saca-rolhas de luz!", "words": [["Resultado?", 0.0, 0.78], ["Taças", 1.0, 1.28], ["menores", 1.28, 1.74], ["e", 1.74, 1.84], ["mais", 1.84, 2.08], ["leves.", 2.08, 2.48], ["E", 2.9, 3.08], ["nessa", 3.08, 3.26], ["época", 3.26, 3.58], ["surgiu", 3.58, 4.22], ["o", 4.22, 4.42], ["air", 4.42, 4.62], ["twist:", 4.62, 5.0], ["uma", 5.42, 5.64], ["bolha", 5.64, 6.02], ["de", 6.02, 6.02], ["ar", 6.02, 6.18], ["torcida", 6.18, 6.7], ["dentro", 6.7, 7.12], ["da", 7.12, 7.44], ["haste,", 7.44, 7.76], ["como", 7.9, 8.0], ["um", 8.0, 8.16], ["saca-rolhas", 8.16, 8.7], ["de", 8.7, 8.86], ["luz!", 8.86, 9.06]], "dur": 9.560816}, {"text": "Em mil novecentos e cinquenta e oito, o austríaco Claus Riedel mostra uma taça lisa, fina, sem enfeite. Só o vinho aparecendo!", "words": [["Em", 0.0, 0.52], ["mil", 0.52, 0.7], ["novecentos", 0.7, 1.32], ["e", 1.32, 1.46], ["cinquenta", 1.46, 1.8], ["e", 1.8, 1.9], ["oito,", 1.9, 2.16], ["o", 2.32, 2.5], ["austríaco", 2.5, 2.9], ["Claus", 2.9, 3.36], ["Riedel", 3.36, 3.72], ["mostra", 3.72, 4.14], ["uma", 4.14, 4.42], ["taça", 4.42, 4.78], ["lisa,", 4.78, 5.14], ["fina,", 5.48, 5.78], ["sem", 5.9, 6.02], ["enfeite.", 6.02, 6.64], ["Só", 6.92, 7.2], ["o", 7.2, 7.32], ["vinho", 7.32, 7.44], ["aparecendo!", 7.44, 8.02]], "dur": 8.515918}, {"text": "Depois, ele lança uma taça diferente pra cada uva! Mas isso é ciência... ou marketing?", "words": [["Depois,", 0.0, 0.48], ["ele", 0.64, 0.72], ["lança", 0.72, 0.94], ["uma", 0.94, 1.14], ["taça", 1.14, 1.48], ["diferente", 1.48, 1.88], ["pra", 1.88, 2.22], ["cada", 2.22, 2.48], ["uva!", 2.48, 2.82], ["Mas", 3.32, 3.48], ["isso", 3.48, 3.68], ["é", 3.68, 3.9], ["ciência...", 3.9, 4.38], ["ou", 4.38, 4.78], ["marketing?", 4.78, 5.18]], "dur": 5.250612}, {"text": "Primeiro, o mito: diziam que a taça joga o vinho num ponto certo da língua. Lenda! O gosto se sente na língua toda.", "words": [["Primeiro,", 0.0, 0.66], ["o", 0.8, 0.94], ["mito:", 0.94, 1.52], ["diziam", 1.78, 2.0], ["que", 2.0, 2.14], ["a", 2.14, 2.32], ["taça", 2.32, 2.58], ["joga", 2.58, 2.94], ["o", 2.94, 3.02], ["vinho", 3.02, 3.16], ["num", 3.16, 3.36], ["ponto", 3.36, 3.7], ["certo", 3.7, 4.02], ["da", 4.02, 4.24], ["língua.", 4.24, 4.88], ["Lenda!", 5.1, 5.46], ["O", 5.82, 5.98], ["gosto", 5.98, 6.26], ["se", 6.26, 6.54], ["sente", 6.54, 6.74], ["na", 6.74, 6.94], ["língua", 6.94, 7.32], ["toda.", 7.32, 7.62]], "dur": 8.176327}, {"text": "Já o cheiro muda de verdade! Num estudo alemão com cento e oitenta e uma pessoas, o formato da taça mudou a nota do aroma.", "words": [["Já", 0.0, 0.42], ["o", 0.42, 0.68], ["cheiro", 0.68, 0.98], ["muda", 0.98, 1.36], ["de", 1.36, 1.6], ["verdade!", 1.6, 2.06], ["Num", 2.64, 2.78], ["estudo", 2.78, 3.06], ["alemão", 3.06, 3.42], ["com", 3.42, 3.66], ["cento", 3.66, 4.0], ["e", 4.0, 4.06], ["oitenta", 4.06, 4.42], ["e", 4.42, 4.44], ["uma", 4.44, 4.62], ["pessoas,", 4.62, 5.06], ["o", 5.4, 5.56], ["formato", 5.56, 5.88], ["da", 5.88, 6.1], ["taça", 6.1, 6.36], ["mudou", 6.36, 6.78], ["a", 6.78, 6.96], ["nota", 6.96, 7.16], ["do", 7.16, 7.38], ["aroma.", 7.38, 7.64]], "dur": 8.097959}, {"text": "E no Japão, criaram uma câmera que enxerga o vapor do álcool! Com o vinho a treze graus, o álcool fez um anel na borda... e deixou o meio livre pro aroma.", "words": [["E", 0.0, 0.18], ["no", 0.18, 0.34], ["Japão,", 0.34, 0.76], ["criaram", 0.98, 1.14], ["uma", 1.14, 1.38], ["câmera", 1.38, 1.68], ["que", 1.68, 1.9], ["enxerga", 1.9, 2.24], ["o", 2.24, 2.34], ["vapor", 2.34, 2.62], ["do", 2.62, 2.84], ["álcool!", 2.84, 3.12], ["Com", 3.44, 3.66], ["o", 3.66, 3.8], ["vinho", 3.8, 3.94], ["a", 3.94, 4.18], ["treze", 4.18, 4.46], ["graus,", 4.46, 4.84], ["o", 5.04, 5.22], ["álcool", 5.22, 5.44], ["fez", 5.44, 5.66], ["um", 5.66, 5.9], ["anel", 5.9, 6.12], ["na", 6.12, 6.36], ["borda...", 6.36, 6.96], ["e", 6.96, 7.16], ["deixou", 7.16, 7.46], ["o", 7.46, 7.58], ["meio", 7.58, 7.72], ["livre", 7.72, 8.12], ["pro", 8.12, 8.34], ["aroma.", 8.34, 8.68]], "dur": 8.96}, {"text": "E o mesmo vinho a vinte e quatro graus? O anel sumiu! É aqui que entra a haste.", "words": [["E", 0.0, 0.26], ["o", 0.26, 0.38], ["mesmo", 0.38, 0.64], ["vinho", 0.64, 0.88], ["a", 0.88, 1.1], ["vinte", 1.1, 1.4], ["e", 1.4, 1.54], ["quatro", 1.54, 1.7], ["graus?", 1.7, 2.62], ["O", 3.02, 3.12], ["anel", 3.12, 3.34], ["sumiu!", 3.34, 3.84], ["É", 4.6, 4.82], ["aqui", 4.82, 5.02], ["que", 5.02, 5.38], ["entra", 5.38, 5.58], ["a", 5.58, 5.84], ["haste.", 5.84, 6.18]], "dur": 6.50449}, {"text": "Sua mão está a uns trinta e seis graus. Pegando pelo bojo, a parte redonda, você esquenta o vinho aos poucos... e deixa digital no vidro!", "words": [["Sua", 0.0, 0.6], ["mão", 0.6, 0.8], ["está", 0.8, 0.98], ["a", 0.98, 1.06], ["uns", 1.06, 1.24], ["trinta", 1.24, 1.6], ["e", 1.6, 1.7], ["seis", 1.7, 1.88], ["graus.", 1.88, 2.46], ["Pegando", 2.62, 2.9], ["pelo", 2.9, 3.1], ["bojo,", 3.1, 3.56], ["a", 3.76, 3.76], ["parte", 3.76, 4.0], ["redonda,", 4.0, 4.5], ["você", 4.88, 5.12], ["esquenta", 5.12, 5.46], ["o", 5.46, 5.64], ["vinho", 5.64, 5.82], ["aos", 5.82, 6.1], ["poucos...", 6.1, 7.36], ["e", 7.36, 7.54], ["deixa", 7.54, 7.96], ["digital", 7.96, 8.56], ["no", 8.56, 8.78], ["vidro!", 8.78, 9.14]], "dur": 9.430204}, {"text": "Pela haste, o vinho fica fresco, o vidro limpo, e dá pra girar. O giro solta o aroma, e a boca mais fechada guarda o cheiro pro nariz.", "words": [["Pela", 0.0, 0.68], ["haste,", 0.68, 1.12], ["o", 1.18, 1.3], ["vinho", 1.3, 1.44], ["fica", 1.44, 1.7], ["fresco,", 1.7, 2.26], ["o", 2.44, 2.52], ["vidro", 2.52, 2.8], ["limpo,", 2.8, 3.18], ["e", 3.32, 3.42], ["dá", 3.42, 3.58], ["pra", 3.58, 3.68], ["girar.", 3.68, 4.44], ["O", 4.74, 4.88], ["giro", 4.88, 5.24], ["solta", 5.24, 5.6], ["o", 5.6, 5.78], ["aroma,", 5.78, 6.02], ["e", 6.28, 6.42], ["a", 6.42, 6.5], ["boca", 6.5, 6.7], ["mais", 6.7, 7.08], ["fechada", 7.08, 7.66], ["guarda", 7.66, 8.1], ["o", 8.1, 8.26], ["cheiro", 8.26, 8.5], ["pro", 8.5, 8.64], ["nariz.", 8.64, 9.02]], "dur": 9.116735}, {"text": "E aqui no Brasil? Nosso clássico nem tem haste: o copo americano, de mil novecentos e quarenta e sete. E foi parar num museu de Nova York!", "words": [["E", 0.05, 0.232], ["aqui", 0.247, 0.565], ["no", 0.593, 0.819], ["Brasil?", 0.839, 1.293], ["Nosso", 1.332, 1.695], ["clássico", 1.727, 2.226], ["nem", 2.269, 2.542], ["tem", 2.565, 2.838], ["haste:", 2.861, 3.27], ["o", 3.305, 3.487], ["copo", 3.503, 3.82], ["americano,", 3.848, 4.438], ["de", 4.489, 4.716], ["mil", 4.736, 5.008], ["novecentos", 5.032, 5.621], ["e", 5.673, 5.854], ["quarenta", 5.87, 6.369], ["e", 6.413, 6.594], ["sete.", 6.61, 6.973], ["E", 7.004, 7.186], ["foi", 7.202, 7.474], ["parar", 7.498, 7.861], ["num", 7.892, 8.164], ["museu", 8.188, 8.551], ["de", 8.583, 8.81], ["Nova", 8.829, 9.147], ["York!", 9.175, 9.538]], "dur": 9.72, "estimado": true}, {"text": "Resumindo: o pé é grego, a haste alta é de Murano, a taça leve veio do imposto... e pela haste o vinho fica fresco e cheiroso!", "words": [["Resumindo:", 0.05, 0.662], ["o", 0.716, 0.904], ["pé", 0.921, 1.156], ["é", 1.177, 1.365], ["grego,", 1.381, 1.805], ["a", 1.842, 2.031], ["haste", 2.047, 2.424], ["alta", 2.457, 2.787], ["é", 2.815, 3.004], ["de", 3.02, 3.256], ["Murano,", 3.276, 3.747], ["a", 3.788, 3.977], ["taça", 3.993, 4.323], ["leve", 4.352, 4.681], ["veio", 4.71, 5.04], ["do", 5.069, 5.304], ["imposto...", 5.325, 5.937], ["e", 5.99, 6.179], ["pela", 6.195, 6.525], ["haste", 6.554, 6.931], ["o", 6.963, 7.152], ["vinho", 7.168, 7.545], ["fica", 7.578, 7.908], ["fresco", 7.936, 8.36], ["e", 8.397, 8.586], ["cheiroso!", 8.602, 9.167]], "dur": 9.37, "estimado": true}, {"text": "Curtiu? Se inscreve no canal e me conta: você segura a taça pela haste ou pelo bojo?", "words": [["Curtiu?", 0.05, 0.513], ["Se", 0.554, 0.785], ["inscreve", 0.805, 1.315], ["no", 1.36, 1.591], ["canal", 1.611, 1.982], ["e", 2.014, 2.2], ["me", 2.216, 2.447], ["conta:", 2.468, 2.885], ["você", 2.921, 3.245], ["segura", 3.273, 3.69], ["a", 3.727, 3.912], ["taça", 3.928, 4.253], ["pela", 4.281, 4.605], ["haste", 4.633, 5.004], ["ou", 5.036, 5.268], ["pelo", 5.288, 5.612], ["bojo?", 5.641, 6.011]], "dur": 6.19, "estimado": true}, {"text": "Wine Know. Dark Divino.", "words": [["Wine", 0.08, 0.4], ["Know.", 0.448, 0.72], ["Dark", 0.832, 1.28], ["Divino.", 1.34, 1.84]], "dur": 1.880816}]