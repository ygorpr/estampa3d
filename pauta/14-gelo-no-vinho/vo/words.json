[{"text": "Pode colocar gelo no vinho? Ou isso é crime? Fica comigo, que a resposta vai te surpreender!", "words": [["Pode", 0.0, 0.3], ["colocar", 0.3, 0.82], ["gelo", 0.82, 1.2], ["no", 1.2, 1.32], ["vinho?", 1.32, 1.72], ["Ou", 2.04, 2.12], ["isso", 2.12, 2.34], ["é", 2.34, 2.52], ["crime?", 2.52, 2.76], ["Fica", 3.28, 3.5], ["comigo,", 3.5, 3.82], ["que", 3.92, 4.04], ["a", 4.04, 4.24], ["resposta", 4.24, 4.52], ["vai", 4.52, 4.84], ["te", 4.84, 5.16], ["surpreender!", 5.16, 5.6]], "dur": 6.112653}, {"text": "Na França, existe até nome pra isso: \"piscine\", que quer dizer piscina! É o espumante, o vinho com gás, servido com gelo numa taça grandona.", "words": [["Na", 0.0, 0.42], ["França,", 0.42, 0.84], ["existe", 0.86, 1.1], ["até", 1.1, 1.32], ["nome", 1.32, 1.56], ["pra", 1.56, 1.82], ["isso:", 1.82, 2.1], ["\"piscine\",", 2.4, 2.76], ["que", 2.98, 3.08], ["quer", 3.08, 3.18], ["dizer", 3.18, 3.54], ["piscina!", 3.54, 4.08], ["É", 4.5, 4.6], ["o", 4.6, 4.74], ["espumante,", 4.74, 5.2], ["o", 5.36, 5.48], ["vinho", 5.48, 5.66], ["com", 5.66, 5.88], ["gás,", 5.88, 6.22], ["servido", 6.44, 6.66], ["com", 6.66, 6.96], ["gelo", 6.96, 7.2], ["numa", 7.2, 7.38], ["taça", 7.38, 7.78], ["grandona.", 7.78, 8.3]], "dur": 8.881633}, {"text": "Erro ou tradição? E por que a tal \"temperatura ambiente\" do vinho tinto era bem mais fria antigamente? Vamos por partes!", "words": [["Erro", 0.0, 0.64], ["ou", 0.64, 0.84], ["tradição?", 0.84, 1.46], ["E", 1.98, 2.06], ["por", 2.06, 2.26], ["que", 2.26, 2.38], ["a", 2.38, 2.56], ["tal", 2.56, 2.84], ["\"temperatura", 2.84, 3.38], ["ambiente\"", 3.38, 3.88], ["do", 3.88, 4.1], ["vinho", 4.1, 4.38], ["tinto", 4.38, 4.74], ["era", 4.74, 5.1], ["bem", 5.1, 5.36], ["mais", 5.36, 5.64], ["fria", 5.64, 5.9], ["antigamente?", 5.9, 6.52], ["Vamos", 7.18, 7.38], ["por", 7.38, 7.6], ["partes!", 7.6, 7.94]], "dur": 8.254694}, {"text": "Primeiro: misturar coisa no vinho é antigo! Os gregos quase nunca bebiam vinho puro: misturavam com água, num vaso grande chamado cratera.", "words": [["Primeiro:", 0.0, 0.58], ["misturar", 0.84, 1.16], ["coisa", 1.16, 1.46], ["no", 1.46, 1.68], ["vinho", 1.68, 1.92], ["é", 1.92, 2.24], ["antigo!", 2.24, 2.78], ["Os", 3.18, 3.36], ["gregos", 3.36, 3.72], ["quase", 3.72, 4.0], ["nunca", 4.0, 4.38], ["bebiam", 4.38, 4.72], ["vinho", 4.72, 5.02], ["puro:", 5.02, 5.44], ["misturavam", 5.64, 6.08], ["com", 6.08, 6.3], ["água,", 6.3, 6.64], ["num", 6.84, 6.92], ["vaso", 6.92, 7.42], ["grande", 7.42, 7.64], ["chamado", 7.64, 8.04], ["cratera.", 8.04, 8.62]], "dur": 8.85551}, {"text": "E os romanos ricos iam além: compravam neve das montanhas pra gelar a bebida. O imperador Nero fervia a água e gelava num vaso enterrado na neve!", "words": [["E", 0.0, 0.44], ["os", 0.44, 0.62], ["romanos", 0.62, 1.04], ["ricos", 1.04, 1.38], ["iam", 1.38, 1.62], ["além:", 1.62, 1.88], ["compravam", 2.38, 2.72], ["neve", 2.72, 3.08], ["das", 3.08, 3.22], ["montanhas", 3.22, 3.74], ["pra", 3.74, 3.96], ["gelar", 3.96, 4.34], ["a", 4.34, 4.48], ["bebida.", 4.48, 4.8], ["O", 5.52, 5.66], ["imperador", 5.66, 6.12], ["Nero", 6.12, 6.46], ["fervia", 6.46, 6.96], ["a", 6.96, 7.14], ["água", 7.14, 7.26], ["e", 7.26, 7.52], ["gelava", 7.52, 7.92], ["num", 7.92, 8.06], ["vaso", 8.06, 8.52], ["enterrado", 8.52, 8.98], ["na", 8.98, 9.16], ["neve!", 9.16, 9.52]], "dur": 10.13551}, {"text": "E o filósofo Sêneca achava isso um luxo absurdo! Gastar fortunas... com neve!", "words": [["E", 0.0, 0.22], ["o", 0.22, 0.38], ["filósofo", 0.38, 0.84], ["Sêneca", 0.84, 1.3], ["achava", 1.3, 1.64], ["isso", 1.64, 1.9], ["um", 1.9, 2.1], ["luxo", 2.1, 2.38], ["absurdo!", 2.38, 3.14], ["Gastar", 3.28, 3.64], ["fortunas...", 3.64, 4.48], ["com", 4.48, 4.66], ["neve!", 4.66, 4.96]], "dur": 5.01551}, {"text": "Agora, pula pra Espanha. No calor de Córdoba, um dono de pousada misturou vinho tinto com refrigerante e gelo. Nasceu o \"tinto de verano\": o tinto de verão!", "words": [["Agora,", 0.0, 0.5], ["pula", 0.7, 0.82], ["pra", 0.82, 0.98], ["Espanha.", 0.98, 1.72], ["No", 1.94, 2.0], ["calor", 2.0, 2.24], ["de", 2.24, 2.54], ["Córdoba,", 2.54, 2.98], ["um", 3.18, 3.28], ["dono", 3.28, 3.48], ["de", 3.48, 3.6], ["pousada", 3.6, 3.98], ["misturou", 3.98, 4.46], ["vinho", 4.46, 4.72], ["tinto", 4.72, 5.04], ["com", 5.04, 5.34], ["refrigerante", 5.34, 5.98], ["e", 5.98, 6.18], ["gelo.", 6.18, 6.66], ["Nasceu", 6.86, 7.2], ["o", 7.2, 7.56], ["\"tinto", 7.56, 7.92], ["de", 7.92, 8.14], ["verano\":", 8.14, 8.62], ["o", 8.86, 9.12], ["tinto", 9.12, 9.4], ["de", 9.4, 9.62], ["verão!", 9.62, 9.8]], "dur": 10.187755}, {"text": "E no País Basco, conta a história que, numa festa de mil novecentos e setenta e dois, o vinho estava ruim... e salvaram tudo com Coca-Cola! Virou o \"kalimotxo\".", "words": [["E", 0.0, 0.42], ["no", 0.42, 0.56], ["País", 0.56, 0.88], ["Basco,", 0.88, 1.38], ["conta", 1.66, 1.76], ["a", 1.76, 1.86], ["história", 1.86, 2.12], ["que,", 2.12, 2.42], ["numa", 2.5, 2.72], ["festa", 2.72, 3.06], ["de", 3.06, 3.36], ["mil", 3.36, 3.54], ["novecentos", 3.54, 4.24], ["e", 4.24, 4.38], ["setenta", 4.38, 4.66], ["e", 4.66, 4.82], ["dois,", 4.82, 5.04], ["o", 5.32, 5.48], ["vinho", 5.48, 5.68], ["estava", 5.68, 5.96], ["ruim...", 5.96, 6.52], ["e", 6.52, 6.68], ["salvaram", 6.68, 7.26], ["tudo", 7.26, 7.56], ["com", 7.56, 7.82], ["Coca-Cola!", 7.82, 8.42], ["Virou", 8.86, 9.2], ["o", 9.2, 9.34], ["\"kalimotxo\".", 9.34, 9.98]], "dur": 10.318367}, {"text": "E a piscine? Ela vem das praias de Saint-Tropez, no sul da França. Dizem que o pessoal já bebia assim nos anos sessenta, no calorão do verão.", "words": [["E", 0.0, 0.52], ["a", 0.52, 0.68], ["piscine?", 0.68, 1.04], ["Ela", 1.3, 1.42], ["vem", 1.42, 1.56], ["das", 1.56, 1.76], ["praias", 1.76, 2.08], ["de", 2.08, 2.36], ["Saint-Tropez,", 2.36, 2.98], ["no", 3.16, 3.28], ["sul", 3.28, 3.44], ["da", 3.44, 3.76], ["França.", 3.76, 4.4], ["Dizem", 4.64, 4.84], ["que", 4.84, 4.92], ["o", 4.92, 5.08], ["pessoal", 5.08, 5.34], ["já", 5.34, 5.58], ["bebia", 5.58, 5.88], ["assim", 5.88, 6.12], ["nos", 6.12, 6.28], ["anos", 6.28, 6.5], ["sessenta,", 6.5, 7.02], ["no", 7.18, 7.36], ["calorão", 7.36, 7.88], ["do", 7.88, 8.08], ["verão.", 8.08, 8.3]], "dur": 8.515918}, {"text": "Até que, em dois mil e onze, a Moët, uma das casas de champanhe mais famosas do mundo, lançou um champanhe feito pra beber com gelo! Três pedras, taça grande.", "words": [["Até", 0.0, 0.4], ["que,", 0.4, 0.62], ["em", 0.64, 0.78], ["dois", 0.78, 0.88], ["mil", 0.88, 1.1], ["e", 1.1, 1.26], ["onze,", 1.26, 1.5], ["a", 1.86, 1.96], ["Moët,", 1.96, 2.3], ["uma", 2.44, 2.6], ["das", 2.6, 2.82], ["casas", 2.82, 3.2], ["de", 3.2, 3.32], ["champanhe", 3.32, 3.7], ["mais", 3.7, 4.0], ["famosas", 4.0, 4.5], ["do", 4.5, 4.7], ["mundo,", 4.7, 5.02], ["lançou", 5.32, 5.52], ["um", 5.52, 5.68], ["champanhe", 5.68, 6.08], ["feito", 6.08, 6.38], ["pra", 6.38, 6.58], ["beber", 6.58, 6.86], ["com", 6.86, 7.24], ["gelo!", 7.24, 7.8], ["Três", 7.96, 8.26], ["pedras,", 8.26, 8.8], ["taça", 9.04, 9.34], ["grande.", 9.34, 9.64]], "dur": 10.083265}, {"text": "E sabe o segredo? Ele é mais docinho de propósito. Porque o gelo derrete... e dilui: ou seja, mistura água no vinho.", "words": [["E", 0.0, 0.34], ["sabe", 0.34, 0.56], ["o", 0.56, 0.72], ["segredo?", 0.72, 1.26], ["Ele", 1.42, 1.58], ["é", 1.58, 1.72], ["mais", 1.72, 2.02], ["docinho", 2.02, 2.46], ["de", 2.46, 2.82], ["propósito.", 2.82, 3.46], ["Porque", 3.66, 3.88], ["o", 3.88, 4.08], ["gelo", 4.08, 4.36], ["derrete...", 4.36, 5.2], ["e", 5.2, 5.38], ["dilui:", 5.38, 5.7], ["ou", 6.14, 6.3], ["seja,", 6.3, 6.66], ["mistura", 6.98, 7.2], ["água", 7.2, 7.52], ["no", 7.52, 7.72], ["vinho.", 7.72, 7.96]], "dur": 8.306939}, {"text": "Quanto? Faz a conta comigo: pra gelar uma taça de vinho quente, uns vinte gramas de gelo derretem. Pode passar de dez por cento de água no seu copo!", "words": [["Quanto?", 0.0, 0.8], ["Faz", 1.26, 1.48], ["a", 1.48, 1.7], ["conta", 1.7, 1.86], ["comigo:", 1.86, 2.26], ["pra", 2.7, 2.86], ["gelar", 2.86, 3.24], ["uma", 3.24, 3.46], ["taça", 3.46, 3.84], ["de", 3.84, 3.98], ["vinho", 3.98, 4.14], ["quente,", 4.14, 4.6], ["uns", 4.82, 4.96], ["vinte", 4.96, 5.28], ["gramas", 5.28, 5.58], ["de", 5.58, 5.82], ["gelo", 5.82, 6.1], ["derretem.", 6.1, 6.64], ["Pode", 6.94, 7.08], ["passar", 7.08, 7.48], ["de", 7.48, 7.72], ["dez", 7.72, 7.94], ["por", 7.94, 8.12], ["cento", 8.12, 8.4], ["de", 8.4, 8.66], ["água", 8.66, 8.8], ["no", 8.8, 9.02], ["seu", 9.02, 9.22], ["copo!", 9.22, 9.58]], "dur": 9.717551}, {"text": "E o frio ainda \"fecha\" o vinho: o aroma, que é o cheiro da bebida, quase não sobe do copo gelado. E o tinto gelado demais fica amargo e áspero!", "words": [["E", 0.0, 0.24], ["o", 0.24, 0.42], ["frio", 0.42, 0.64], ["ainda", 0.64, 1.02], ["\"fecha\"", 1.02, 1.38], ["o", 1.38, 1.54], ["vinho:", 1.54, 1.78], ["o", 2.12, 2.3], ["aroma,", 2.3, 2.6], ["que", 2.8, 2.9], ["é", 2.9, 3.1], ["o", 3.1, 3.22], ["cheiro", 3.22, 3.44], ["da", 3.44, 3.62], ["bebida,", 3.62, 4.1], ["quase", 4.36, 4.5], ["não", 4.5, 4.76], ["sobe", 4.76, 5.02], ["do", 5.02, 5.18], ["copo", 5.18, 5.52], ["gelado.", 5.52, 5.94], ["E", 6.38, 6.5], ["o", 6.5, 6.62], ["tinto", 6.62, 6.86], ["gelado", 6.86, 7.32], ["demais", 7.32, 7.82], ["fica", 7.82, 8.3], ["amargo", 8.3, 8.94], ["e", 8.94, 9.12], ["áspero!", 9.12, 9.5]], "dur": 9.874286}, {"text": "E a tal temperatura ambiente? Em francês, é o vinho \"chambré\": deixado na temperatura da \"chambre\", o cômodo da casa.", "words": [["E", 0.0, 0.54], ["a", 0.54, 0.72], ["tal", 0.72, 0.86], ["temperatura", 0.86, 1.42], ["ambiente?", 1.42, 1.92], ["Em", 2.4, 2.58], ["francês,", 2.58, 3.2], ["é", 3.34, 3.48], ["o", 3.48, 3.64], ["vinho", 3.64, 3.86], ["\"chambré\":", 3.86, 4.6], ["deixado", 4.82, 5.16], ["na", 5.16, 5.28], ["temperatura", 5.28, 5.88], ["da", 5.88, 6.08], ["\"chambre\",", 6.08, 6.48], ["o", 6.7, 6.92], ["cômodo", 6.92, 7.2], ["da", 7.2, 7.36], ["casa.", 7.36, 7.66]], "dur": 7.967347}, {"text": "Só que essa regra nasceu numa Europa sem aquecedor. A sala de jantar ficava entre treze e dezoito graus!", "words": [["Só", 0.0, 0.44], ["que", 0.44, 0.66], ["essa", 0.66, 0.86], ["regra", 0.86, 1.24], ["nasceu", 1.24, 1.52], ["numa", 1.52, 1.72], ["Europa", 1.72, 2.18], ["sem", 2.18, 2.54], ["aquecedor.", 2.54, 3.26], ["A", 3.62, 3.76], ["sala", 3.76, 3.98], ["de", 3.98, 4.16], ["jantar", 4.16, 4.66], ["ficava", 4.66, 5.08], ["entre", 5.08, 5.38], ["treze", 5.38, 5.78], ["e", 5.78, 6.02], ["dezoito", 6.02, 6.46], ["graus!", 6.46, 6.86]], "dur": 6.922449}, {"text": "E aqui no Brasil? No verão, a sala passa fácil dos trinta graus! Tinto a trinta graus? O álcool aparece, e o vinho fica pesado e quente na boca.", "words": [["E", 0.073, 0.08], ["aqui", 0.128, 0.32], ["no", 0.347, 0.4], ["Brasil?", 0.457, 1.08], ["No", 1.173, 1.36], ["verão,", 1.4, 1.84], ["a", 1.88, 1.92], ["sala", 2.0, 2.32], ["passa", 2.368, 2.64], ["fácil", 2.733, 3.2], ["dos", 3.24, 3.36], ["trinta", 3.387, 3.68], ["graus!", 3.74, 4.16], ["Tinto", 4.4, 4.88], ["a", 4.96, 5.04], ["trinta", 5.067, 5.28], ["graus?", 5.36, 5.84], ["O", 6.04, 6.24], ["álcool", 6.32, 6.56], ["aparece,", 6.613, 7.28], ["e", 7.32, 7.36], ["o", 7.4, 7.44], ["vinho", 7.48, 7.68], ["fica", 7.728, 7.92], ["pesado", 8.02, 8.56], ["e", 8.6, 8.64], ["quente", 8.693, 9.04], ["na", 9.067, 9.12], ["boca.", 9.2, 9.6]], "dur": 9.8135}, {"text": "Então, anota a temperatura certa: espumante, de seis a dez graus. Branco e rosé, de sete a doze. E o tinto, de quinze a dezoito: mais fresquinho do que a sua sala!", "words": [["Então,", 0.2134999999999998, 0.43350000000000044], ["anota", 0.5404999999999998, 0.9935000000000009], ["a", 1.153500000000001, 1.3135000000000012], ["temperatura", 1.3405000000000005, 1.6334999999999997], ["certa:", 1.7134999999999998, 2.3535000000000004], ["espumante,", 2.413500000000001, 3.073500000000001], ["de", 3.153500000000001, 3.3135000000000012], ["seis", 3.3775000000000013, 3.6334999999999997], ["a", 3.7135, 3.7935], ["dez", 3.833500000000001, 3.9535], ["graus.", 4.0135000000000005, 4.7135], ["Branco", 4.8065, 5.233500000000001], ["e", 5.313500000000001, 5.393500000000001], ["rosé,", 5.4335, 5.7135], ["de", 5.7935, 5.9535], ["sete", 6.053500000000001, 6.4735], ["a", 6.533500000000002, 6.593500000000001], ["doze.", 6.646500000000001, 7.073500000000001], ["E", 7.233500000000001, 7.393500000000001], ["o", 7.4335, 7.4735], ["tinto,", 7.553500000000001, 8.033500000000002], ["de", 8.0865, 8.193500000000002], ["quinze", 8.2735, 8.5935], ["a", 8.673499999999999, 8.7535], ["dezoito:", 8.806500000000002, 9.553500000000001], ["mais", 9.6015, 9.7935], ["fresquinho", 9.8575, 10.353500000000002], ["do", 10.3805, 10.4335], ["que", 10.4535, 10.513500000000002], ["a", 10.553500000000001, 10.5935], ["sua", 10.673499999999999, 10.9135], ["sala!", 10.9935, 11.393500000000001]], "dur": 11.680000000000001}, {"text": "Quer gelar sem aguar? Coloca uva congelada na taça! Ela esfria e não solta água nenhuma. Ou pedras de aço, que vão no congelador.", "words": [["Quer", 0.2865000000000002, 0.35350000000000037], ["gelar", 0.4134999999999991, 0.6735000000000007], ["sem", 0.7334999999999994, 0.9134999999999991], ["aguar?", 0.9664999999999999, 1.3134999999999977], ["Coloca", 1.413499999999999, 1.9534999999999982], ["uva", 2.0734999999999992, 2.2734999999999985], ["congelada", 2.333500000000001, 2.833500000000001], ["na", 2.886499999999998, 2.9934999999999974], ["taça!", 3.0734999999999992, 3.5534999999999997], ["Ela", 3.6864999999999988, 4.073499999999999], ["esfria", 4.113499999999998, 4.433499999999999], ["e", 4.473499999999998, 4.5135000000000005], ["não", 4.5535, 4.673500000000001], ["solta", 4.753499999999999, 5.073499999999999], ["água", 5.1534999999999975, 5.3934999999999995], ["nenhuma.", 5.433499999999999, 6.0335], ["Ou", 6.113499999999998, 6.2734999999999985], ["pedras", 6.3535, 6.753499999999999], ["de", 6.7805, 6.833500000000001], ["aço,", 6.913499999999999, 7.3535], ["que", 7.383499999999998, 7.473499999999998], ["vão", 7.5535, 7.7135], ["no", 7.766500000000001, 7.8735], ["congelador.", 7.933499999999999, 8.913499999999999]], "dur": 8.939152999999997}, {"text": "Tá com pressa? Balde com gelo, água e um punhado de sal! O sal deixa a água mais fria que o próprio gelo. Em uns dez minutos, a garrafa tá pronta!", "words": [["Tá", 0.072, 0.16], ["com", 0.18, 0.24], ["pressa?", 0.307, 0.72], ["Balde", 0.9, 1.52], ["com", 1.58, 1.76], ["gelo,", 1.84, 2.32], ["água", 2.4, 2.72], ["e", 2.8, 2.88], ["um", 2.907, 2.96], ["punhado", 3.02, 3.44], ["de", 3.467, 3.52], ["sal!", 3.6, 3.84], ["O", 4.12, 4.4], ["sal", 4.46, 4.64], ["deixa", 4.693, 4.88], ["a", 4.92, 4.96], ["água", 5.0, 5.2], ["mais", 5.264, 5.52], ["fria", 5.56, 5.76], ["que", 5.78, 5.84], ["o", 5.92, 6.0], ["próprio", 6.048, 6.4], ["gelo.", 6.46, 7.04], ["Em", 7.067, 7.12], ["uns", 7.16, 7.28], ["dez", 7.34, 7.52], ["minutos,", 7.58, 8.16], ["a", 8.2, 8.24], ["garrafa", 8.28, 8.64], ["tá", 8.693, 8.8], ["pronta!", 8.853, 9.52]], "dur": 9.835}, {"text": "E o tinto? Quinze minutinhos na geladeira antes de abrir. Simples assim!", "words": [["E", 0.3149999999999995, 0.3249999999999993], ["o", 0.36499999999999844, 0.40499999999999936], ["tinto?", 0.48499999999999943, 0.8859999999999992], ["Quinze", 1.097999999999999, 1.7649999999999988], ["minutinhos", 1.8179999999999996, 2.3249999999999993], ["na", 2.3519999999999985, 2.4049999999999994], ["geladeira", 2.4449999999999985, 2.885], ["antes", 2.965, 3.3649999999999984], ["de", 3.3919999999999995, 3.4449999999999985], ["abrir.", 3.5119999999999987, 4.164999999999999], ["Simples", 4.244999999999999, 4.645], ["assim!", 4.697999999999999, 5.484999999999999]], "dur": 5.812999999999999}, {"text": "Então, gelo no vinho é crime? Não! Num rosé ou num espumante leve, num dia de praia, tudo bem. Num tinto caro, guardado por anos... aí é desperdício!", "words": [["Então,", 0.3280000000000012, 0.5120000000000005], ["gelo", 0.6320000000000014, 1.0719999999999992], ["no", 1.09